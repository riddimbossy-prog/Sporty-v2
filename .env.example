# Add these in Render after the staging service first opens.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_SAFE_SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
# Direct public SportyBet collector. The defaults below are also in render.yaml.
SPORTYBET_COUNTRY=gh
SPORTYBET_PUBLIC_EVENTS_URL=https://www.sportybet.com/api/{country}/factsCenter/pcUpcomingEvents?sportId=sr%3Asport%3A1&marketId=1&pageNum={page}&pageSize=100
SPORTYBET_PUBLIC_CODEHUB_URL=https://www.sportybet.com/{country}/m/code-hub/codes
# Add only when a public booking-detail endpoint is confirmed. Use {code}.
SPORTYBET_PUBLIC_BOOKING_URL_TEMPLATE=
SPORTYBET_MAX_PAGES=3
SPORTYBET_CODE_EXPANSION_LIMIT=6

# Optional fallback and statistics enrichment; not required for collector readiness.
API_FOOTBALL_KEY=

# Optional. Leave blank until the core service is verified.
ODDS_API_KEY=
ODDS_API_SPORT_KEYS=
ODDS_API_REGIONS=eu,uk

# Render generates CUSTOM_API_ADMIN_TOKEN automatically from render.yaml.
CUSTOM_API_ADMIN_TOKEN=

# Cost and cache controls.
UPSTREAM_DAILY_REQUEST_BUDGET=30
EVENT_CACHE_TTL_SECONDS=1800
CODE_CACHE_TTL_SECONDS=300
STATS_CACHE_TTL_SECONDS=28800
API_RATE_LIMIT_PER_MINUTE=120
EVENT_DAYS_AHEAD=3
UPSTREAM_TIMEOUT_MS=16000

# Browser-agent replacement for the old Parse.bot workflow.
SPORTYBET_BROWSER_COLLECTOR_ENABLED=true
SPORTYBET_BROWSER_CODEHUB_URL=https://www.sportybet.com/gh/m/code-hub/codes
SPORTYBET_BROWSER_LOAD_CODE_URL=https://www.sportybet.com/gh/m/code-hub/load-code
SPORTYBET_BROWSER_CODE_LIMIT=20
SPORTYBET_BROWSER_PAGE_WAIT_MS=8000
SPORTYBET_BROWSER_AFTER_SUBMIT_MS=6500
SPORTYBET_BROWSER_EXPANSION_DELAY_MS=900
SPORTYBET_BROWSER_SCHEDULE_ENABLED=true
SPORTYBET_BROWSER_SCHEDULE_MINUTES=60
SPORTYBET_BROWSER_START_DELAY_MS=45000
CHROMIUM_PATH=/usr/bin/chromium
