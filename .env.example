# Add these in Render after the staging service first opens.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_SAFE_SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

# Optional. Leave blank until the core service is verified.
ODDS_API_KEY=
ODDS_API_SPORT_KEYS=
ODDS_API_REGIONS=eu,uk

# Render generates CUSTOM_API_ADMIN_TOKEN automatically from render.yaml.
CUSTOM_API_ADMIN_TOKEN=

# Cost and cache controls.
UPSTREAM_DAILY_REQUEST_BUDGET=30
EVENT_CACHE_TTL_SECONDS=1800
CODE_CACHE_TTL_SECONDS=300
STATS_CACHE_TTL_SECONDS=28800
API_RATE_LIMIT_PER_MINUTE=120
EVENT_DAYS_AHEAD=3
UPSTREAM_TIMEOUT_MS=16000
